{
  "name": "sshmcp",
  "version": "0.1.0",
  "description": "Stateful SSH MCP daemon with dual-channel (exec + persistent PTY) access over HTTP/SSE",
  "type": "module",
  "bin": { "sshmcp": "dist/main.js" },
  "engines": { "node": ">=20" },
  "files": ["dist", "service", "scripts", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js daemon --foreground",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@xterm/headless": "^5.5.0",
    "express": "^4.21.2",
    "ssh2": "^1.17.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/ssh2": "^1.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
